# Razorpay Test Mode Credentials
# Get your test key & secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Groq API Key for Shopping Agent (Get free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_YourGroqApiKeyHere

# MongoDB Connection (Optional: defaults to in-memory store if unset)
# MONGODB_URI=mongodb://localhost:27017/agent_storefront

# App Secret for Mandate HMAC Signature
MANDATE_SIGNING_SECRET=your_mandate_signing_secret_here
